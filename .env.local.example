# Copy to .env.local for local development, then set the same variable in Vercel.
# Never commit a real API key.
OPENAI_API_KEY=
# Optional. A model with Structured Outputs support is required.
OPENAI_MODEL=gpt-5-mini
# Alternative: Zhipu AI. Do not set OPENAI_API_KEY at the same time.
ZHIPU_API_KEY=
# Optional. Use a model enabled for Chat Completions, tool calling, and JSON output.
ZHIPU_MODEL=glm-4-flash
# iFinD Streamable HTTP MCP. Keep the real token in .env.local or Vercel only.
IFIND_MCP_TOKEN=
IFIND_STOCK_MCP_URL=
IFIND_NEWS_MCP_URL=
