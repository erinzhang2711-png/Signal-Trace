# Copy to .env.local for local development, then set the same variable in Vercel.
# Never commit a real API key.
OPENAI_API_KEY=
# Optional. A model with Structured Outputs support is required.
OPENAI_MODEL=gpt-5-mini
# iFinD Streamable HTTP MCP. Keep the real token in .env.local or Vercel only.
IFIND_MCP_TOKEN=
IFIND_STOCK_MCP_URL=
IFIND_NEWS_MCP_URL=
